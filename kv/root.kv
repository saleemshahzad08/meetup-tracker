# kv/root.kv — the app shell: screen area on top, tab buttons at the bottom

<RootWidget>:
    orientation: "vertical"

    ScreenManager:
        id: screen_manager

    BoxLayout:
        size_hint_y: None
        height: dp(56)

        MDFlatButton:
            text: "Add Payment"
            on_release: root.switch_tab("add_payment")

        MDFlatButton:
            text: "Summary"
            on_release: root.switch_tab("summary")

        MDFlatButton:
            text: "Expenses"
            on_release: root.switch_tab("expenses")
